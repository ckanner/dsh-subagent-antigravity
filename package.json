{
  "name": "@ckanner/dsh-subagent-antigravity",
  "version": "0.3.3",
  "description": "DeepSeek Harness and Flywheel: human-controlled official Antigravity ACP sessions by default, with an explicit legacy machine interface",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./machine": {
      "types": "./lib/machine.d.ts",
      "import": "./lib/machine.js"
    },
    "./client": "./assets/client.js",
    "./package.json": "./package.json",
    "./acp": {
      "types": "./lib/acp/index.d.ts",
      "import": "./lib/acp/index.js"
    },
    "./acp/host": "./lib/acp/host.js",
    "./acp/workspace": "./lib/acp/workspace.js",
    "./acp/client-source": "./assets/acp-client.js"
  },
  "bin": {
    "antigravity-machine": "bin/antigravity-machine.js"
  },
  "files": [
    "lib",
    "bin",
    "assets",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:package": "node scripts/test-package.js",
    "test:host-install": "node scripts/test-host-install.js",
    "check": "npm test && npm run test:package"
  },
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.2-rc.3 <0.4.0-0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.9.1",
    "ajv": "8.17.1",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.1.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.3 <0.4.0-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.3.0-0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^22.20.5",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckanner/dsh-subagent-antigravity.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/ckanner/dsh-subagent-antigravity#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "antigravity",
    "agy",
    "gemini",
    "subagent",
    "delegation",
    "google"
  ]
}
